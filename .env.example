# Groq (LLM for review analysis and brief generation — free tier at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Serper.dev (Google search — serper.dev)
SERPER_API_KEY=your_serper_api_key_here

# Google Places API (console.cloud.google.com)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_random_verify_token_here

# PostgreSQL — Neon (neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# App settings
MAX_BUSINESSES=20
MIN_BUSINESSES=10

# Dashboard API key — must match DASHBOARD_API_KEY in your frontend env
DASHBOARD_API_KEY=your_dashboard_api_key_here

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
